{
  "name": "npm-launcher",
  "version": "1.0.8",
  "description": "NPM 项目启动器 - 可视化管理多个 NPM 项目",
  "author": "xiaotai",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --config vite.config.mts",
    "build": "tauri build --no-bundle",
    "build:frontend": "vite build --config vite.config.mts",
    "preview": "vite preview --config vite.config.mts",
    "start": "tauri dev",
    "dist": "node scripts/bump-version.js && tauri build",
    "dist:all": "node scripts/bump-version.js && tauri build",
    "dist:win": "node scripts/bump-version.js --skip && tauri build --bundles nsis",
    "dist:mac": "node scripts/bump-version.js --skip && tauri build --bundles dmg",
    "dist:ask": "node scripts/bump-version.js --ask && tauri build",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
