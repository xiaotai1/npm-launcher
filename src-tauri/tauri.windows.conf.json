{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NPM Launcher",
        "width": 1100,
        "height": 680,
        "minWidth": 920,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0f172a"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}
